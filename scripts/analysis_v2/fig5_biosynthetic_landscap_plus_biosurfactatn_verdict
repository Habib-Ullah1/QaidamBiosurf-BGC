source("fig_common.R")
DIR <- "/data/habib/metagenome/biosurfactant/analysis_v2_community_abundance"

# both files are HEADERLESS
bgc <- read_tsv(file.path(DIR,"all_bgc_products.tsv"), col_names=FALSE, show_col_types=FALSE)
colnames(bgc)[1:4] <- c("sample","contig","products","bin")
nc  <- read_tsv(file.path(DIR,"nrps_classified.tsv"), col_names=FALSE, show_col_types=FALSE)
colnames(nc) <- c("sample","contig","starterC","nAMP","bin","season","label")[1:ncol(nc)]

d5 <- bgc %>% mutate(season=ifelse(substr(sample,1,1)=="C","summer","winter"),
                     binned=ifelse(bin=="UNBINNED"|is.na(bin),"unbinned","binned")) %>%
  separate_rows(products, sep=";") %>% filter(products!="")

top <- d5 %>% count(products, sort=TRUE) %>% slice_head(n=12) %>% pull(products)
d5a <- d5 %>% mutate(products=ifelse(products %in% top,products,"other")) %>%
  count(season,products) %>% group_by(season) %>% mutate(pct=100*n/sum(n)) %>% ungroup()
ord <- d5a %>% group_by(products) %>% summarise(t=sum(n)) %>% arrange(t) %>% pull(products)
p5a <- ggplot(d5a, aes(pct, factor(products,ord), fill=season)) +
  geom_col(position="dodge", width=.7) + scale_fill_manual(values=SEASON, name=NULL) +
  labs(x="% of BGCs", y=NULL, subtitle="BGC class composition") +
  theme_pub() + theme(legend.position="top")

d5b <- d5 %>% mutate(grp=ifelse(grepl("NRPS",products),"NRPS-class","all BGCs")) %>%
  count(grp,binned) %>% group_by(grp) %>% mutate(pct=100*n/sum(n)) %>% ungroup()
p5b <- ggplot(d5b, aes(grp,pct,fill=binned)) + geom_col(width=.6) +
  geom_text(aes(label=sprintf("%.0f%%",pct)), position=position_stack(vjust=.5), size=3, color="white")+
  scale_fill_manual(values=c(binned="#2a78d6", unbinned="#b0aeb0"), name=NULL) +
  labs(x=NULL, y="% of clusters", subtitle="Most BGCs unbinned") +
  theme_pub() + theme(legend.position="top")

# lipopeptide verdict: starter-C > 0 = lipopeptide-type
d5c <- tibble(type=c("lipopeptide (starter-C)","other NRPS"),
              n=c(sum(nc$starterC>0, na.rm=TRUE), sum(nc$starterC==0 | is.na(nc$starterC))))
p5c <- ggplot(d5c, aes(x=2,y=n,fill=type)) + geom_col(width=1,color="white") +
  coord_polar("y") + xlim(.5,2.5) +
  geom_text(aes(label=n), position=position_stack(vjust=.5), size=3.4) +
  scale_fill_manual(values=c("lipopeptide (starter-C)"="#e34948","other NRPS"="#9aa0a6"),name=NULL)+
  labs(subtitle=sprintf("Lipopeptide: %d of %d NRPS", d5c$n[1], sum(d5c$n))) +
  theme_void(base_size=11) + theme(legend.position="right",
     plot.subtitle=element_text(size=10,hjust=.5))

fig5 <- (p5a | (p5b / p5c)) + plot_layout(widths=c(1.3,1)) + plot_annotation(tag_levels="A")
ggsave(file.path(DIR,"Fig5_biosynthetic_verdict.pdf"), fig5, width=11, height=7)
ggsave(file.path(DIR,"Fig5_biosynthetic_verdict.png"), fig5, width=11, height=7, dpi=300)
message("wrote Fig5")
