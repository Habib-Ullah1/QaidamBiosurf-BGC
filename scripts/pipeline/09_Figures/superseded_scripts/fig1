#!/usr/bin/env Rscript
# Figure 1 — Study system: ionic gradient, 16S seasonal turnover, MAG recovery
suppressWarnings(suppressMessages({
  need <- c("ggplot2","patchwork","dplyr","tidyr","grid")
  miss <- need[!need %in% rownames(installed.packages())]
  if (length(miss)) install.packages(miss, repos="https://cloud.r-project.org")
  library(ggplot2); library(patchwork); library(dplyr); library(tidyr); library(grid)
}))
B <- "/data/habib/metagenome/biosurfactant"
pc  <- read.delim(file.path(B,"integration/bgc_mag_mapping/pcoa_season.tsv"), stringsAsFactors=FALSE)
rec <- read.delim(file.path(B,"integration/bgc_mag_mapping/mag_recovery.tsv"), stringsAsFactors=FALSE)
ion <- read.delim(file.path(B,"integration/bgc_mag_mapping/ions.tsv"), stringsAsFactors=FALSE)
sea_pal <- c(Summer="#D55E00", Winter="#2166AC")
R2 <- 0.193; pval <- 0.001; ax1 <- 23.0; ax2 <- 19.1

th <- theme_classic(base_size=8, base_family="sans") +
  theme(axis.text=element_text(colour="#444444", size=7.3), axis.title=element_text(colour="#111111", size=8.3),
        axis.line=element_line(colour="#444444", linewidth=0.4), axis.ticks=element_line(colour="#444444", linewidth=0.4),
        plot.tag=element_text(face="bold", size=12), plot.title=element_text(size=8.3,face="bold", hjust=0.5),
        legend.position="none", plot.margin=margin(8,7,4,5))

# a: ion gradient
il <- ion %>% pivot_longer(cols=c(Cl,Na,Mg,Ca,K), names_to="ion", values_to="conc")
il$ion <- factor(il$ion, levels=c("Na","Cl","Mg","Ca","K"),
                 labels=c("Na\u207a","Cl\u207b","Mg\u00b2\u207a","Ca\u00b2\u207a","K\u207a"))
il$season <- factor(il$season, levels=c("Summer","Winter"))
ils <- il %>% group_by(ion,season) %>% summarise(conc=mean(conc), .groups="drop")
pa <- ggplot(ils, aes(ion, conc, fill=season)) +
  geom_col(position=position_dodge(width=0.7), width=0.62, colour="white", linewidth=0.3) +
  geom_point(data=il, aes(ion, conc, group=season), position=position_dodge(width=0.7),
             shape=21, fill="white", colour="#555555", size=1.0, stroke=0.35) +
  scale_y_log10(labels=function(x) ifelse(x>=1000, paste0(x/1000,"k"), as.character(x)),
                breaks=c(1,10,100,1000,10000,100000), expand=expansion(mult=c(0,0.06))) +
  scale_fill_manual(values=sea_pal, name=NULL) +
  labs(title="Porewater ions", x=NULL, y="mg / L  (log scale)", tag="a") +
  th + theme(legend.position="top", legend.text=element_text(size=6.8),
             legend.key.size=unit(0.28,"cm"), legend.margin=margin(0,0,0,0),
             axis.text.x=element_text(size=8.5))

# b: PCoA
hulls <- pc %>% group_by(season) %>% slice(chull(PCo1, PCo2))
pb <- ggplot(pc, aes(PCo1, PCo2)) +
  geom_polygon(data=hulls, aes(fill=season, group=season), alpha=0.12, colour=NA) +
  geom_vline(xintercept=0, colour="#E8E8E8", linewidth=0.4) + geom_hline(yintercept=0, colour="#E8E8E8", linewidth=0.4) +
  geom_point(aes(fill=season, shape=type), size=2.2, stroke=0.5, colour="white") +
  scale_shape_manual(values=c(Sediment=21, Water=24, Rock=22), name="Type") +
  scale_fill_manual(values=sea_pal, name="Season") +
  annotate("text", x=-0.31, y=0.60, label=paste0("PERMANOVA\nR\u00b2 = ", R2, ", P = ", pval),
           hjust=0, size=2.4, colour="#222222", fontface="bold", lineheight=0.95) +
  annotate("text", x=0.33, y=0.30, label="Winter", colour="#2166AC", fontface="bold", size=2.7) +
  annotate("text", x=-0.30, y=-0.27, label="Summer", colour="#D55E00", fontface="bold", size=2.7) +
  labs(title="16S community turnover", x=paste0("PCo1 (",ax1,"%)"), y=paste0("PCo2 (",ax2,"%)"), tag="b") +
  guides(fill=guide_legend(order=1, override.aes=list(shape=21, size=2.4)),
         shape=guide_legend(order=2, override.aes=list(fill="#888888"))) +
  th + theme(legend.position="right", legend.title=element_text(size=6.6,face="bold"),
             legend.text=element_text(size=6.4), legend.key.size=unit(0.26,"cm"))

# c: MAG recovery
rec$sample <- factor(rec$sample, levels=c("C3","C6","H2","H6"))
recl <- rbind(data.frame(sample=rec$sample, season=rec$season, cat="Total bins", n=rec$bins),
              data.frame(sample=rec$sample, season=rec$season, cat=">=70% complete", n=rec$hq70))
recl$cat <- factor(recl$cat, levels=c("Total bins",">=70% complete"))
pcc <- ggplot(recl, aes(sample, n, fill=season, alpha=cat)) +
  geom_col(position="identity", width=0.66, colour="white", linewidth=0.4) +
  geom_text(data=rec, aes(sample, bins, label=bins), vjust=-0.5, size=2.4, colour="#555555", inherit.aes=FALSE) +
  geom_text(data=rec, aes(sample, hq70, label=hq70), vjust=-0.5, size=2.4, colour="white", fontface="bold", inherit.aes=FALSE) +
  scale_fill_manual(values=sea_pal, guide="none") +
  scale_alpha_manual(values=c("Total bins"=0.38, ">=70% complete"=1), name=NULL) +
  scale_y_continuous(expand=expansion(mult=c(0,0.12))) +
  labs(title="MAG recovery", x=NULL, y="Metagenome bins", tag="c") +
  th + theme(legend.position="top", legend.text=element_text(size=6.2),
             legend.key.size=unit(0.24,"cm"), legend.margin=margin(0,0,0,0))

fig <- (pa | pb | pcc) + plot_layout(widths=c(0.95,1.3,0.92))
dir.create(file.path(B,"figures"), showWarnings=FALSE)
ggsave(file.path(B,"figures/Figure1_setting.pdf"), fig, width=185, height=82, units="mm", device=cairo_pdf)
ggsave(file.path(B,"figures/Figure1_setting.png"), fig, width=185, height=82, units="mm", dpi=400)
cat("written: figures/Figure1_setting.pdf (+ .png)\n")
